<%- include('partials/header',{title:'Student Dashboard'}) %>
<div class="app-shell">
<aside class="sidebar"><div class="brand"><div class="brand-mark">KC</div><div><strong>Kundaram Chandrakala</strong><small>Student Portal</small></div></div><div class="nav-title">My learning</div><nav class="side-nav"><button data-section="overview">⌂ <span>Overview</span></button><button data-section="homework">▣ <span>Homework</span></button><button data-section="tests">✓ <span>Tests & Results</span></button><button data-section="attendance">◉ <span>Attendance</span></button><button data-section="fees">₹ <span>Fees</span></button><button data-section="classes">◷ <span>My Classes</span></button><button data-section="leave">✦ <span>Leave Requests</span></button><button data-section="updates">● <span>Announcements</span></button></nav><div class="sidebar-footer"><div class="teacher-mini"><small>Teacher</small><strong>Kundaram Chandrakala</strong></div></div></aside>
<main class="main"><header class="topbar"><div class="top-actions"><button class="mobile-menu" data-menu style="color:#000 !important;background:transparent;">☰</button><div class="topbar-title"><h1 data-page-title>Overview</h1><p data-page-desc>Your learning snapshot.</p></div></div><div class="top-actions"><div class="avatar"><%=student.name.slice(0,1)%></div><form method="post" action="/logout"><button class="secondary">Logout</button></form></div></header><div class="content">
<section class="section active" data-panel="overview" data-title="Overview" data-desc="Your learning snapshot."><div class="grid two"><section class="card hero"><span class="pill">Std <%=student.standard%></span><h2>Welcome, <%=student.name%> 👋</h2><p>Keep your attendance, homework and tests on track. Your next actions are shown below.</p><div class="toolbar"><%if(student.assignedExamId){%><a class="button" href="/exam">Open <%=student.assignedExamTitle%></a><%}else{%><button class="secondary" disabled>No online test assigned</button><%}%><button class="secondary" data-section="homework">View homework</button></div></section><section class="card"><h3>Quick status</h3><div class="item-row item"><span>Homework</span><span class="pill <%=student.homeworkStatus==='done'?'success':'warning'%>"><%=student.homeworkStatus==='done'?'Done':'Pending'%></span></div><div class="item-row item"><span>Attendance</span><strong><%=attendance.filter(x=>x.status==='present'||x.status==='late').length%>/<%=attendance.length%></strong></div><div class="item-row item"><span>Fees</span><span class="pill <%=fees.some(f=>!f.paid)?'danger':'success'%>"><%=fees.some(f=>!f.paid)?'Pending':'Up to date'%></span></div><div class="item-row item"><span>Announcements</span><strong><%=announcements.length%></strong></div></section></div><div class="grid cards" style="margin-top:16px"><div class="card stat"><div class="iconbox">✓</div><div class="stat-label">Attendance</div><div class="stat-value"><%=attendance.length?Math.round(attendance.filter(x=>x.status==='present'||x.status==='late').length/attendance.length*100):0%>%</div><div class="stat-foot">Based on recorded classes</div></div><div class="card stat"><div class="iconbox">▣</div><div class="stat-label">Homework</div><div class="stat-value"><%=student.homeworkStatus==='done'?'Done':'Pending'%></div><div class="stat-foot">Update after completing work</div></div><div class="card stat"><div class="iconbox">✓</div><div class="stat-label">Latest Result</div><div class="stat-value"><%=marks[0]?.marks??'-'%></div><div class="stat-foot"><%=marks[0]?.testId?.name||'No result yet'%></div></div><div class="card stat"><div class="iconbox">₹</div><div class="stat-label">Fee Status</div><div class="stat-value">updating soon</div><div class="stat-foot"><%=fees.filter(f=>!f.paid).length%> record(s)</div></div></div></section>

<section class="section" data-panel="homework" data-title="Homework" data-desc="View protected study material and update completion status."><div class="grid two"><section class="card"><h3>Assigned homework</h3><%if(!homeworks.length){%><div class="empty">No homework assigned.</div><%}homeworks.forEach(h=>{%><article class="item"><div class="item-row"><strong><%=h.title%></strong><span class="pill"><%=h.subject||'General'%></span></div><p class="muted"><%=h.description||'No description provided.'%></p><span class="small">Due: <%=new Date(h.dueDate).toLocaleDateString()%></span><%if(h.attachment){%><div class="file-row"><span>📎 <%=h.attachment.originalName%></span><a class="button" href="/homework/<%=h._id%>/view">View material</a></div><%}%></article><%})%></section><section class="card"><h3>Homework status</h3><p class="muted">Mark your work done after completing it.</p><form method="post" action="/homework-status"><label>Status<select name="status"><option value="not_done" <%=student.homeworkStatus!=='done'?'selected':''%>>Not completed</option><option value="done" <%=student.homeworkStatus==='done'?'selected':''%>>Homework done</option></select></label><label>Note<textarea name="note" placeholder="Optional note for teacher"><%=student.homeworkNote||''%></textarea></label><button>Save homework status</button></form></section></div></section>

<section class="section" data-panel="tests" data-title="Tests & Results" data-desc="Take assigned online tests and review your marks."><div class="card hero"><h2><%=student.assignedExamTitle||"No test assigned"%></h2><p><%=student.assignedExamId?"Your assigned paper contains 20 questions: 10 Direct → Indirect and 10 Grammar questions.":"Your teacher has not assigned an online test yet."%></p><%if(student.assignedExamId){%><a class="button" href="/exam">Open test</a><%}%></div><div class="card" style="margin-top:16px"><h3>My results</h3><div class="table-wrap"><table><tr><th>Test</th><th>Subject</th><th>Marks</th><th>Total</th><th>Date</th></tr><%if(!marks.length){%><tr><td colspan="5" class="empty">No marks recorded yet.</td></tr><%}marks.forEach(m=>{%><tr><td><strong><%=m.testId?.name||'Test'%></strong></td><td><%=m.testId?.subject||'-'%></td><td><%=m.marks%></td><td><%=m.testId?.totalMarks||'-'%></td><td><%=m.testId?.date?new Date(m.testId.date).toLocaleDateString():'-'%></td></tr><%})%></table></div></div></section>

<section class="section" data-panel="attendance" data-title="Attendance" data-desc="Review your attendance history."><div class="card"><div class="grid cards"><div class="card stat"><div class="stat-label">Present / Late</div><div class="stat-value"><%=attendance.filter(x=>x.status==='present'||x.status==='late').length%></div></div><div class="card stat"><div class="stat-label">Absent</div><div class="stat-value"><%=attendance.filter(x=>x.status==='absent').length%></div></div><div class="card stat"><div class="stat-label">Leave</div><div class="stat-value"><%=attendance.filter(x=>x.status==='leave').length%></div></div></div><div class="table-wrap" style="margin-top:16px"><table><tr><th>Date</th><th>Status</th><th>Note</th></tr><%attendance.forEach(a=>{%><tr><td><%=new Date(a.date).toLocaleDateString()%></td><td><span class="pill <%=a.status==='present'?'success':a.status==='absent'?'danger':'warning'%>"><%=a.status%></span></td><td><%=a.note||'-'%></td></tr><%})%></table></div></div></section>

<section class="section" data-panel="fees" data-title="Fees" data-desc="See paid and unpaid tuition fees."><div class="card"><div class="table-wrap"><table><tr><th>Month</th><th>Amount</th><th>Due date</th><th>Status</th><th>Paid date</th></tr><%if(!fees.length){%><tr><td colspan="5" class="empty">No fee records yet.</td></tr><%}fees.forEach(f=>{%><tr><td><strong><%=f.month%></strong></td><td>₹<%=f.amount%></td><td><%=new Date(f.dueDate).toLocaleDateString()%></td><td><span class="pill <%=f.paid?'success':'danger'%>"><%=f.paid?'Paid':'Unpaid'%></span></td><td><%=f.paidDate?new Date(f.paidDate).toLocaleDateString():'-'%></td></tr><%})%></table></div></div></section>

<section class="section" data-panel="classes" data-title="My Classes" data-desc="Upcoming tuition sessions for your standard."><div class="grid two"><section class="card"><h3>Upcoming classes</h3><%if(!classes.length){%><div class="empty">No classes scheduled.</div><%}classes.forEach(c=>{%><div class="item"><strong><%=c.title%></strong><div class="small">Std <%=c.standard%> · <%=c.subject||'General'%></div><div class="small"><%=new Date(c.date).toLocaleDateString()%> · <%=c.startTime%>–<%=c.endTime%> · <%=c.room||'Room not set'%></div></div><%})%></section><section class="card"><h3>Class information</h3><div class="notice">You are enrolled in Standard <strong><%=student.standard%></strong>.</div></section></div></section>

<section class="section" data-panel="leave" data-title="Leave Requests" data-desc="Request leave and check approval status."><div class="grid two"><section class="card"><h3>Request leave</h3><form method="post" action="/leave"><div class="form-grid"><label>From<input type="date" name="from" required></label><label>To<input type="date" name="to" required></label></div><label>Reason<input name="reason" placeholder="Reason for leave" required></label><button>Send request</button></form></section><section class="card"><h3>My requests</h3><%if(!leaves.length){%><div class="empty">No leave requests.</div><%}leaves.forEach(l=>{%><div class="item"><div class="item-row"><strong><%=new Date(l.from).toLocaleDateString()%> – <%=new Date(l.to).toLocaleDateString()%></strong><span class="pill <%=l.status==='approved'?'success':l.status==='rejected'?'danger':'warning'%>"><%=l.status%></span></div><p class="muted"><%=l.reason%></p><span class="small"><%=l.teacherNote||'Waiting for teacher response.'%></span></div><%})%></section></div></section>

<section class="section" data-panel="updates" data-title="Announcements" data-desc="Updates from Kundaram Chandrakala Tuition."><div class="card"><%if(!announcements.length){%><div class="empty">No announcements yet.</div><%}announcements.forEach(a=>{%><article class="announcement-card"><div class="announcement-dot"></div><div><div class="item-row"><h3><%=a.title%></h3><span class="pill"><%=a.audience%></span></div><p class="muted"><%=a.body%></p><span class="small"><%=new Date(a.createdAt).toLocaleString()%></span></div></article><%})%></div></section>
</div></main></div>
<script src="/js/dashboard.js"></script><script src="/js/pwa.js"></script><%- include('partials/footer') %>
