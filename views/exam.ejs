<%- include('partials/header',{title:set.title}) %><main class="container" oncontextmenu="return false"><header class="top"><div><h1><%=set.title%></h1><p><%=student.name%> · <%=student.paperCode%></p></div></header><div class="card exam"><div class="watermark" id="watermark"><%=student.name%> · <%=student.paperCode%></div><% if(!state.started){%><h2>Start Test</h2><p><%=set.questions.length%> questions · one at a time · <%=examMinutes%> minutes<% if(set.subject){ %> · <%=set.subject%><% } %>.</p><ul><li>Questions are randomized from your assigned paper.</li><li>Answers are saved automatically.</li><li>Camera permission is requested for monitoring signals.</li><li>Activity events may be logged.</li></ul><button id="startBtn">Start Exam</button><%}else if(state.submitted){%><h2>Exam submitted</h2><p>Your responses are saved.</p><a href="/student">Back to dashboard</a><%}else{%><div class="examhead"><b id="progress">Question</b><b id="timer">--:--</b></div><div id="questionText" class="question">Loading...</div><textarea id="answer" placeholder="Write answers in your notebook..."></textarea><div class="actions"><button id="prevBtn" class="secondary">Previous</button><button id="saveBtn">Next</button><button id="submitBtn" class="danger">Submit</button></div><div class="camera"><video id="camera" autoplay muted playsinline></video><span id="cameraStatus">Camera starting...</span></div><p class="small">Camera video is recorded during the exam and uploaded to the teacher's private server storage when you submit. Unflagged recordings are automatically deleted after 7 days.</p><%}%></div></main><script>window.examConfig={started:<%=state.started?'true':'false'%>,submitted:<%=state.submitted?'true':'false'%>,total:<%=set.questions.length%>,initialIndex:<%=student.examQuestionIndex||0%>,deadline:<%=state.remaining%>,student:<%-JSON.stringify(student.name)%>,code:<%-JSON.stringify(student.paperCode)%>};</script><script src="/js/exam.js"></script><script src="/js/pwa.js"></script><%- include('partials/footer') %>
